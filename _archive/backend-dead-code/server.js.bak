
const express = require("express");
const cors = require("cors");
require("dotenv").config();
const scanRoutes =
require("./routes/scan");
const authRoutes =
require("./routes/auth");
const app = express();
app.use(cors());
app.use(express.json());
app.get("/",(req,res)=>{
    res.json({
        success:true,
        message:
        "🛡️ Sentinel AI Backend Running"
    });
});
app.use(
    "/api/scan",
    scanRoutes
);
app.use(
    "/api/auth",
    authRoutes
);
const PORT =
process.env.PORT || 5000;
app.listen(PORT,()=>{
    console.log("");
    console.log(
        "================================"
    );
    console.log(
        "🛡️ Sentinel AI Backend Started"
    );
    console.log(
        "🌐 http://localhost:"+PORT
    );
    console.log(
        "================================"
    );
});
EOF
